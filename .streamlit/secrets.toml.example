# Streamlit Cloud 部署时，将此文件内容填入 Cloud 后台的 Secrets 配置
# 路径: App Settings → Secrets → 粘贴以下内容（去掉注释，填入真实 Key）
#
# 注意：本地开发请复制此文件为 secrets.toml 并填入真实 Key
#      secrets.toml 已在 .gitignore 中，不会被提交

# ── 方案一：OpenRouter（推荐，支持多模型，价格透明）──────────────────
OPENROUTER_API_KEY = "sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx"

# ── 方案二：直接使用 Anthropic ──────────────────────────────────────
# ANTHROPIC_API_KEY = "sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx"

# ── 方案三：DeepSeek ────────────────────────────────────────────────
# DEEPSEEK_API_KEY = "sk-xxxxxxxxxxxxxxxxxxxxxxxx"
