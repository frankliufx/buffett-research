# 本地数据缓存（不提交，部署环境运行时自动创建目录）
# 注意: /data/cn_policy_themes.yaml 是 curated 产品资产，必须 commit (A5.1)
/data/cache/
/data/runtime/
/data/*.json
/data/*.csv
/data/*.parquet

# Python 虚拟环境
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# 本地环境与密钥（绝不提交）
# 项目策略：API key 应留在浏览器 localStorage，不写盘 — 见 src/keyring.py
.env
.env.*
!.env.example
config.yaml
.streamlit/secrets.toml
users.yaml
# 任何 *_key, *_secret 文件兜底
**/*api_key*
**/*api_secret*
**/secret*.json
**/secret*.yaml
**/secret*.yml

# 日志
logs/
*.log

# macOS
.DS_Store

# IDE
.idea/
.vscode/
.gstack/
